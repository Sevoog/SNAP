<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SNAP</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key>
	<false/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_http._tcp</string>
		<string>_ssh._tcp</string>
		<string>_ftp._tcp</string>
		<string>_afpovertcp._tcp</string>
		<string>_smb._tcp</string>
		<string>_printer._tcp</string>
		<string>_ipp._tcp</string>
	</array>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2025–2026 Sevag Bardakjian. All rights reserved.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>SNAP needs access to the local network for network scanning, Bonjour service discovery, and diagnostics.</string>
	<key>NSLocationUsageDescription</key>
	<string>SNAP needs Location Services access to scan for nearby WiFi networks. macOS requires location permission to reveal network names (SSIDs).</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SNAP needs Location Services access to scan for nearby WiFi networks. macOS requires location permission to reveal network names (SSIDs).</string>
	<key>NSMainStoryboardFile</key>
	<string></string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<false/>
</dict>
</plist>
