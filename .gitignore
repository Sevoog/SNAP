xcuserdata/
*.xcworkspace/xcshareddata/
*.xcuserstate
*.moved-aside
*.orig

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Archives & exports
*.ipa
*.xcarchive
*.dSYM.zip
*.dSYM

# Fastlane (if added later)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# CocoaPods (if added later)
Pods/

# Crash logs
*.crash

# Release builds (attach to GitHub Releases instead of committing)
*.zip
*.dmg

